generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AppCategory {
  pemerintahan
  swasta
}

model User {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(100)
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      String   @default("admin") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model App {
  id          String      @id @default(uuid()) @db.Char(36)
  title       String      @db.VarChar(150)
  description String      @db.Text
  url         String      @db.VarChar(255)
  category    AppCategory
  iconPath    String      @map("icon_path") @db.VarChar(255)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([category])
  @@map("apps")
}

model PortalContent {
  id              Int      @id @default(autoincrement())
  logoUrl         String   @default("/assets/logo/logo-green.png") @map("logo_url")
  headerText      String   @map("header_text")
  paragraphText   String   @db.Text @map("paragraph_text")

  // Bagian Depan Folder 1 (Pemerintahan) - 2 Input
  folder1Title    String   @map("folder1_title")
  folder1Subtitle String   @map("folder1_subtitle")

  // Bagian Depan Folder 2 (Swasta) - 2 Input
  folder2Title    String   @map("folder2_title")
  folder2Subtitle String   @map("folder2_subtitle")

  // Link Floating WhatsApp
  whatsappLink    String   @map("whatsapp_link")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("portal_contents")
}

model Theme {
  id              Int      @id @default(autoincrement())
  name            String   @map("name")
  backgroundImage String   @map("background_image")
  overlayColor    String   @map("overlay_color")
  overlayOpacity  Float    @map("overlay_opacity")
  isActive        Boolean  @default(false) @map("is_active")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("themes")
}


