generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AppCategory {
  pemerintahan
  swasta
}

model User {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(100)
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      String   @default("admin") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Application {
  id          Int          @id @default(autoincrement())
  slug        String       @unique @db.VarChar(120)
  title       String       @default("") @db.VarChar(255)
  name        String       @db.VarChar(150)
  appType     String       @default("") @map("jenis_aplikasi") @db.VarChar(150)
  tagline     String       @default("") @db.VarChar(255)
  features    Json         @default("[]") @map("keunggulan")
  category    AppCategory
  description String       @db.Text
  iconUrl     String       @map("icon_url") @db.VarChar(500)
  appImage    String?      @map("app_image") @db.VarChar(500)
  url         String       @db.VarChar(500)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([category])
  @@map("applications")
}

model PortalContent {
  id                  Int      @id @default(autoincrement())
  logoUrl             String   @default("/assets/logo/logo-green.png") @map("logo_url")
  whatsappLink        String   @default("https://wa.me/6281348039947") @map("whatsapp_link")

  // Modal 1: Request Demo
  requestDemoBadge    String   @default("Layanan Utama") @map("request_demo_badge")
  requestDemoTitle    String   @default("Request Live Demo & Konsultasi") @map("request_demo_title")
  requestDemoDesc     String?  @db.Text @map("request_demo_desc")
  requestDemoFeatures Json     @default("[]") @map("request_demo_features")

  // Modal 2: Jasa Buat Website
  buatWebsiteBadge    String   @default("Web Development") @map("buat_website_badge")
  buatWebsiteTitle    String   @default("Jasa Pembuatan Website & Portal Instansi") @map("buat_website_title")
  buatWebsiteDesc     String?  @db.Text @map("buat_website_desc")
  buatWebsiteFeatures Json     @default("[]") @map("buat_website_features")

  // Modal 3: Buat Aplikasi Custom
  buatAplikasiBadge    String   @default("Custom Software") @map("buat_aplikasi_badge")
  buatAplikasiTitle    String   @default("Pengembangan Aplikasi iOS, Android & ERP") @map("buat_aplikasi_title")
  buatAplikasiDesc     String?  @db.Text @map("buat_aplikasi_desc")
  buatAplikasiFeatures Json     @default("[]") @map("buat_aplikasi_features")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("portal_contents")
}


