generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AppCategory {
  pemerintahan
  swasta
}

model User {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(100)
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      String   @default("admin") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Application {
  id          Int          @id @default(autoincrement())
  slug        String       @unique @db.VarChar(120)
  title       String       @default("") @db.VarChar(255)
  name        String       @db.VarChar(150)
  appType     String       @default("") @map("jenis_aplikasi") @db.VarChar(150)
  tagline     String       @default("") @db.VarChar(255)
  features    Json         @default("[]") @map("keunggulan")
  category    AppCategory
  description String       @db.Text
  iconUrl     String       @map("icon_url") @db.VarChar(500)
  appImage    String?      @map("app_image") @db.VarChar(500)
  url         String       @db.VarChar(500)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([category])
  @@map("applications")
}

model PortalContent {
  id              Int      @id @default(autoincrement())
  logoUrl         String   @default("/assets/logo/logo-green.png") @map("logo_url")
  headerText      String   @map("header_text")
  paragraphText   String   @db.Text @map("paragraph_text")

  // Bagian Depan Folder 1 (Pemerintahan) - 2 Input
  folder1Title    String   @map("folder1_title")
  folder1Subtitle String   @map("folder1_subtitle")

  // Bagian Depan Folder 2 (Swasta) - 2 Input
  folder2Title    String   @map("folder2_title")
  folder2Subtitle String   @map("folder2_subtitle")

  // Link Floating WhatsApp
  whatsappLink    String   @map("whatsapp_link")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("portal_contents")
}

model Theme {
  id                String   @id @default(uuid())
  name              String   @db.VarChar(150)
  bgImage           String   @map("bg_image") @db.VarChar(255)
  modalOverlayColor String   @map("modal_overlay_color") @db.VarChar(100)
  isActive          Boolean  @default(false) @map("is_active")
  isDefault         Boolean  @default(false) @map("is_default")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("themes")
}


